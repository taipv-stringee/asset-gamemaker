 "thua_het_luot": 18,
 "ly_do_het_luot": "Hết vòng 18: quân Thanh ở Nhật Tảo đã kịp lui về giữ Hà Hồi.",
 "muc_tieu_phu": [
  {
   "loai": "khong_thoat",
   "ten": "Không để trinh sát nào thoát về Hà Hồi"
  },
  {
   "loai": "truoc_vong",
   "n": 14,
   "ten": "Chiếm Nhật Tảo trước vòng 14"
  }
 ],
 "goi_y": [
  {
   "khi": "bat_dau",
   "loi": "Năm trinh sát Thanh đang dò quân ta. Thấy quân ta trong 3 ô là chúng chạy về dải đỏ phía bắc. Chạm vào trinh sát để xem."
  },
  {
   "khi": "vong",
   "n": 2,
   "loi": "Trinh sát yếu nhưng chạy nhanh (5 ô). Hạ gọn trong một lượt khi chúng chưa chạy, hoặc dùng lính giáo khống chế đường chạy. Tiền quân ở giữa bản đồ chặn được ở cầu và chỗ sông cạn."
  },
  {
   "khi": "vong",
   "n": 3,
   "loi": "Thần công theo kịp: bắn xa 2–4 ô, mạnh khi bắn quân trên đồn, doanh trại. Đã đi thì lượt đó không bắn được, và không phản đòn. Thần công không qua chỗ sông cạn."
  },
  {
   "khi": "vong",
   "n": 5,
   "loi": "Chiếm đồn Thanh Quyết (giữa – nam) để có chỗ mua lính gần mặt trận hơn."
  },
  {
   "khi": "vong",
   "n": 8,
   "loi": "Cờ rách (quân tan) chắn đường qua cầu thì cho quân sư đứng kề để chiêu hàng: vừa dọn đường, vừa có thêm hàng binh. Thần công đứng bờ nam vẫn bắn tới cổng và đồn Nhật Tảo."
  },
  {
   "khi": "thoat",
   "loi": "Một trinh sát đã thoát về báo tin! Ở màn 6, đồn Hà Hồi sẽ thức sẵn, gọi hàng khó hơn. Chặn trinh sát trước khi chúng tới vùng đỏ phía bắc."
  }
 ],
