 "goi_y": [
  {
   "khi": "bat_dau",
   "loi": "Đồn Hà Hồi (viền vàng) đang ngủ. Vây kín các ô quanh khu đồn, rồi cho quân sư hay Quang Trung đứng kề khu mà Gọi hàng.",
   "khong_co": "he_qua_trinh_sat_thoat"
  },
  {
   "khi": "vong",
   "n": 2,
   "loi": "Dấu × đỏ quanh đồn là chỗ còn hở. Ô có quân ta đứng, hoặc kề một lính giáo (khống chế), là đã kín. Ao bọc phía tây: chỉ còn 2 ô mặt bắc, 3 ô mặt đông, 2 ô mặt nam."
  },
  {
   "khi": "vong",
   "n": 1,
   "loi": "Lính tuần, lính chòi canh còn thức: thấy quân ta là báo động, cả đồn dậy. Hạ gọn từng tên trong một lượt. Đèn và lính ta cầm đuốc làm sáng ô quanh, địch thấy từ xa.",
   "khong_co": "he_qua_trinh_sat_thoat"
  },
  {
   "khi": "vong",
   "n": 4,
   "loi": "Gọi hàng thành công khi tổng máu quân ta trong 2 ô quanh khu đủ lớn so với máu quân trong đồn (quá nửa đang ngủ thì chỉ cần một nửa). Bấm Gọi hàng để xem con số trước khi gọi."
  },
  {
   "khi": "vong",
   "n": 6,
   "loi": "Quân ra hàng thành hàng binh, đồn bỏ trống: Quang Trung vào Chiếm. Kho lương trong khu: tướng hay lính giáo đứng lên rồi Lấy kho lương."
  },
  {
   "khi": "bat_dau",
   "neu_co": "he_qua_trinh_sat_thoat",
   "loi": "Trinh sát lọt lưới đã báo tin: quân trong đồn Hà Hồi (viền vàng) đã thức, đánh quân ta vào tầm. Gọi hàng cần gấp đôi máu so với khi đồn ngủ; chưa đủ thì đánh."
  },
  {
   "khi": "vong",
   "n": 1,
   "neu_co": "he_qua_trinh_sat_thoat",
   "loi": "Đừng áp sát lũy từng quân một: dồn quân ngoài tầm, rồi cùng vây kín và Gọi hàng trong lượt đó. Đèn và lính ta cầm đuốc làm sáng ô quanh, địch thấy từ xa."
  }
 ],
