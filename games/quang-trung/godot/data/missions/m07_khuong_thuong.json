 "goi_y": [
  {
   "khi": "bat_dau",
   "loi": "Doanh trại (ô lều) đốt được: hỏa hổ đứng kề rồi bấm Đốt. Ô cháy 3 vòng, sáng như đuốc; quân đứng trên bị Cháy. Đốt 4 ô trước vòng 7 là mục tiêu phụ."
  },
  {
   "khi": "vong",
   "n": 1,
   "loi": "Thổ binh ngủ trong doanh. Đốt ô có quân là đánh thức nó, nó kêu báo động. Lính tuần thấy quân ta đứng cạnh lửa hay đèn từ 5 ô: hạ lính tuần trước."
  },
  {
   "khi": "vong",
   "n": 3,
   "loi": "Sầm Nghi Đống giữ ô đồn, máu không xuống dưới 1, hồi máu mỗi vòng. Còn 1 máu thì ông rời trận. Pháo binh trên gò bắn xa 2–4 ô: đừng để Long đứng trong tầm."
  },
  {
   "khi": "vong",
   "n": 7,
   "loi": "Trời rạng: mọi quân thức, sương tan dần trong hai vòng. Đô đốc Long giỏi đánh đêm (+10 công), từ vòng 8 mất lợi thế ấy."
  }
 ],
