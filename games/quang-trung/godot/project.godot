; Engine configuration file.
; Godot 4.7.2 — xem BUILD.md

config_version=5

[application]

config/name="Tây Sơn"
config/description="Game chiến thuật theo lượt kiểu Ancient Empires 2 về chiến dịch Quang Trung 1789."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=288
window/size/viewport_height=512
window/size/window_width_override=576
window/size/window_height_override=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.08, 0.05, 0.05, 1)
